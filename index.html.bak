rial", "url": "https://fastapi.tiangolo.com/tutorial/"}, {"title": "Docker Get Started", "url": "https://docs.docker.com/get-started/"}], "video": "https://www.youtube.com/results?search_query=Capstone%3A%20evaluation%2C%20security%20and%20guardrails%20AI%20tutorial", "knowledgeCheck": ["What problem does capstone: evaluation, security and guardrails solve, and when would you avoid using it?", "What are the main failure modes or trade-offs in today's implementation?", "How would you test whether today's solution is actually working correctly?"], "deliverable": "day-88-capstone-evaluation-security-and-guardrails", "checks": ["Study", "Code", "Challenge", "GitHub"]}, {"day": 89, "phaseId": 10, "phase": "Capstone Project", "phaseGoal": "Design, build, evaluate, deploy and present a complete Agentic AI application.", "topic": "Capstone: deployment, README and technical documentation", "objectives": ["Explain the core ideas behind capstone: deployment, readme and technical documentation.", "Implement a working example without copying a finished solution blindly.", "Test, document and commit the result to GitHub."], "studyPlan": [{"label": "Study", "minutes": 45, "text": "Read the linked primary material and write 5–8 concise notes in your own words."}, {"label": "Code", "minutes": 90, "text": "Deploy the application and finish README, setup guide, architecture, screenshots and known limitations."}, {"label": "Challenge", "minutes": 30, "text": "Treat the capstone as production software: test, measure, document and justify every major design choice."}, {"label": "Document", "minutes": 15, "text": "Commit code; update README with objective, approach, result, screenshot/output and one learning point."}], "resources": [{"title": "LangGraph Documentation", "url": "https://docs.langchain.com/oss/python/langgraph/overview"}, {"title": "Model Context Protocol", "url": "https://modelcontextprotocol.io/docs/2026-07-28/getting-started/intro"}, {"title": "FastAPI Official Tutorial", "url": "https://fastapi.tiangolo.com/tutorial/"}, {"title": "Docker Get Started", "url": "https://docs.docker.com/get-started/"}], "video": "https://www.youtube.com/results?search_query=Capstone%3A%20deployment%2C%20README%20and%20technical%20documentation%20AI%20tutorial", "knowledgeCheck": ["What problem does capstone: deployment, readme and technical documentation solve, and when would you avoid using it?", "What are the main failure modes or trade-offs in today's implementation?", "How would you test whether today's solution is actually working correctly?"], "deliverable": "day-89-capstone-deployment-readme-and-technical-documentation", "checks": ["Study", "Code", "Challenge", "GitHub"]}, {"day": 90, "phaseId": 10, "phase": "Capstone Project", "phaseGoal": "Design, build, evaluate, deploy and present a complete Agentic AI application.", "topic": "Capstone: demo, GitHub release and technical presentation", "objectives": ["Explain the core ideas behind capstone: demo, github release and technical presentation.", "Implement a working example without copying a finished solution blindly.", "Test, document and commit the result to GitHub."], "studyPlan": [{"label": "Study", "minutes": 45, "text": "Read the linked primary material and write 5–8 concise notes in your own words."}, {"label": "Code", "minutes": 90, "text": "Record/demo a 5–10 minute walkthrough, tag a GitHub release and prepare a concise technical presentation."}, {"label": "Challenge", "minutes": 30, "text": "Treat the capstone as production software: test, measure, document and justify every major design choice."}, {"label": "Document", "minutes": 15, "text": "Commit code; update README with objective, approach, result, screenshot/output and one learning point."}], "resources": [{"title": "LangGraph Documentation", "url": "https://docs.langchain.com/oss/python/langgraph/overview"}, {"title": "Model Context Protocol", "url": "https://modelcontextprotocol.io/docs/2026-07-28/getting-started/intro"}, {"title": "FastAPI Official Tutorial", "url": "https://fastapi.tiangolo.com/tutorial/"}, {"title": "Docker Get Started", "url": "https://docs.docker.com/get-started/"}], "video": "https://www.youtube.com/results?search_query=Capstone%3A%20demo%2C%20GitHub%20release%20and%20technical%20presentation%20AI%20tutorial", "knowledgeCheck": ["What problem does capstone: demo, github release and technical presentation solve, and when would you avoid using it?", "What are the main failure modes or trade-offs in today's implementation?", "How would you test whether today's solution is actually working correctly?"], "deliverable": "day-90-capstone-demo-github-release-and-technical-presentation", "checks": ["Study", "Code", "Challenge", "GitHub"]}], "phases": [{"id": 1, "start": 1, "end": 10, "title": "Python & AI Engineering Foundations", "goal": "Build the software-engineering base needed for LLM and agent systems."}, {"id": 2, "start": 11, "end": 20, "title": "Prompt & Context Engineering", "goal": "Design reliable instructions, structured outputs and high-quality model context."}, {"id": 3, "start": 21, "end": 30, "title": "RAG Engineering", "goal": "Build grounded retrieval systems from ingestion through evaluation."}, {"id": 4, "start": 31, "end": 40, "title": "AI Agents from Scratch", "goal": "Understand and implement agent loops before relying on frameworks."}, {"id": 5, "start": 41, "end": 47, "title": "LangGraph Intensive", "goal": "Build stateful, controllable and human-supervised agent workflows."}, {"id": 6, "start": 48, "end": 55, "title": "Memory, MCP & Agent Skills", "goal": "Connect agents to memory, external tools and reusable capabilities."}, {"id": 7, "start": 56, "end": 65, "title": "Agent Framework Engineering", "goal": "Compare and implement modern agent frameworks based on engineering needs."}, {"id": 8, "start": 66, "end": 73, "title": "Multi-Agent Systems", "goal": "Coordinate specialized agents using routing, supervision and parallelism."}, {"id": 9, "start": 74, "end": 82, "title": "Production Agentic AI", "goal": "Evaluate, secure, observe, optimize, package and deploy agent systems."}, {"id": 10, "start": 83, "end": 90, "title": "Capstone Project", "goal": "Design, build, evaluate, deploy and present a complete Agentic AI application."}]};
const K="aiml-agentic-90-v2", TK="aiml-agentic-theme-v2";
let state=JSON.parse(localStorage.getItem(K)||"{}");

const $=id=>document.getElementById(id);
function ds(d){if(!state[d])state[d]={};return state[d]}
function done(d){return DATA.days[d-1].checks.every(c=>!!ds(d)[c])}
function count(){return DATA.days.filter(x=>done(x.day)).length}
function current(){const x=DATA.days.find(x=>!done(x.day));return x?x.day:90}
function save(){localStorage.setItem(K,JSON.stringify(state));renderAll()}

function switchView(id){
 document.querySelectorAll(".view").forEach(v=>v.classList.toggle("active",v.id===id));
 document.querySelectorAll(".nav button").forEach(b=>b.classList.toggle("active",b.dataset.view===id));
 window.scrollTo({top:0,behavior:"smooth"});
}
document.querySelectorAll(".nav button").forEach(b=>b.onclick=()=>switchView(b.dataset.view));

function renderProgress(){
 let c=count(),p=Math.round(c/90*100);$("progTitle").textContent=`${c} of 90 days completed`;$("pct").textContent=p+"%";$("bar").style.width=p+"%";
}
function renderPhases(){
 $("phaseGrid").innerHTML=DATA.phases.map(p=>{let arr=DATA.days.filter(d=>d.phaseId===p.id),c=arr.filter(d=>done(d.day)).length;return `<div class="phase" onclick="openDay(${p.start})"><div class="meta"><span>Phase ${p.id}</span><span>${c}/${arr.length}</span></div><h3>${p.title}</h3><p class="muted">${p.goal}</p><div class="meta"><span>Days ${p.start}–${p.end}</span><span>${Math.round(c/arr.length*100)}%</span></div></div>`}).join("");
}
function renderCalendar(){
 let cur=current();$("calendar").innerHTML=DATA.days.map(d=>`<button class="day ${done(d.day)?"done":""} ${d.day===cur&&!done(d.day)?"current":""}" title="Day ${d.day}: ${d.topic}" onclick="openDay(${d.day})">${d.day}</button>`).join("");
}
function renderRoadmap(q=""){
 q=q.trim().toLowerCase();let groups=DATA.phases.map(p=>{
  let days=DATA.days.filter(d=>d.phaseId===p.id && (!q || String(d.day).includes(q)||d.topic.toLowerCase().includes(q)||d.phase.toLowerCase().includes(q)));
  if(!days.length)return "";
  return `<div style="margin:22px 0"><span class="pill">Phase ${p.id} • Days ${p.start}–${p.end}</span><h3>${p.title}</h3>${days.map(d=>`<div class="phase" style="margin:7px 0" onclick="openDay(${d.day})"><div class="meta"><span>Day ${d.day}</span><span>${done(d.day)?"Completed ✓":"Open lesson →"}</span></div><b>${d.topic}</b></div>`).join("")}</div>`;
 }).join("");$("roadmapList").innerHTML=groups||"<p>No matching day found.</p>";
}
function openDay(n){
 switchView("roadmap");let d=DATA.days[n-1],s=ds(n),panel=$("dayPanel");panel.classList.remove("hidden");
 panel.innerHTML=`<div class="day-head"><div><span class="pill">Day ${d.day} • Phase ${d.phaseId}</span><h2>${d.topic}</h2><p class="muted">${d.phase}</p></div><button class="btn primary" id="completeDay">${done(n)?"Completed ✓":"Mark Day Complete"}</button></div>
 <p class="goal"><b>Phase goal:</b> ${d.phaseGoal}</p>
 <div class="grid2"><div><h3>Learning Objectives</h3><ul>${d.objectives.map(x=>`<li>${x}</li>`).join("")}</ul></div><div><h3>Evidence to Produce</h3><p>GitHub folder/repository:</p><code>${d.deliverable}</code><p class="muted">Include objective, code, result/output, test/edge case, screenshot where useful, and learning summary.</p></div></div>
 <h3>Today's 3-Hour Study Plan</h3><div class="plan">${d.studyPlan.map(x=>`<div class="slot"><b>${x.label}</b><small>${x.minutes} minutes</small><p>${x.text}</p></div>`).join("")}</div>
 <h3>Study Material & Video</h3><div class="resources">${d.resources.map(r=>`<a class="resource" href="${r.url}" target="_blank" rel="noopener"><b>📖 ${r.title}</b><span>Open official/free material ↗</span></a>`).join("")}<a class="resource" href="${d.video}" target="_blank" rel="noopener"><b>🎥 Video Tutorials</b><span>YouTube search for today's exact topic ↗</span></a></div>
 <h3>Knowledge Check</h3><ol>${d.knowledgeCheck.map(q=>`<li>${q}</li>`).join("")}</ol>
 <h3>Completion Checklist</h3><div class="checks">${d.checks.map(c=>`<label><input type="checkbox" data-c="${c}" ${s[c]?"checked":""}> ${c}</label>`).join("")}</div>
 <div class="button-row"><button class="btn outline" onclick="${n>1?`openDay(${n-1})`:""}">← Previous</button><button class="btn primary" onclick="${n<90?`openDay(${n+1})`:""}">Next Day →</button></div>`;
 panel.querySelectorAll("[data-c]").forEach(x=>x.onchange=()=>{ds(n)[x.dataset.c]=x.checked;save();openDay(n)});
 $("completeDay").onclick=()=>{d.checks.forEach(c=>ds(n)[c]=true);save();openDay(n)};
 setTimeout(()=>panel.scrollIntoView({behavior:"smooth",block:"start"}),50);
}
function renderResources(){
 let unique={};DATA.days.flatMap(d=>d.resources).forEach(r=>unique[r.url]=r);
 $("resourceLibrary").innerHTML=Object.values(unique).map(r=>`<a class="resource" href="${r.url}" target="_blank" rel="noopener"><b>${r.title}</b><span>${new URL(r.url).hostname} ↗</span></a>`).join("");
}
function renderProjects(){
 const nums=[10,20,30,40,47,55,60,62,65,73,82,90];
 $("projectGrid").innerHTML=nums.map(n=>{let d=DATA.days[n-1];return `<div class="project"><span class="pill">Day ${n}</span><h3>${d.topic}</h3><p class="muted">${d.studyPlan[1].text}</p><button class="btn soft" onclick="openDay(${n})">Open Project</button></div>`}).join("");
}
function renderAll(){renderProgress();renderPhases();renderCalendar();renderRoadmap($("search")?.value||"");renderResources();renderProjects()}
$("continue").onclick=()=>openDay(current());$("todayPlan").onclick=()=>openDay(current());
$("search").oninput=e=>renderRoadmap(e.target.value);
$("export").onclick=()=>{let blob=new Blob([JSON.stringify({exportedAt:new Date().toISOString(),completed:count(),progress:state},null,2)],{type:"application/json"}),a=document.createElement("a");a.href=URL.createObjectURL(blob);a.download="agentic-ai-90-progress.json";a.click();URL.revokeObjectURL(a.href)};
$("reset").onclick=()=>{if(confirm("Reset all progress saved on this device?")){state={};localStorage.removeItem(K);renderAll()}};
if(localStorage.getItem(TK)==="dark")document.body.classList.add("dark");
$("theme").onclick=()=>{document.body.classList.toggle("dark");localStorage.setItem(TK,document.body.classList.contains("dark")?"dark":"light")};
window.openDay=openDay;renderAll();
</script>
</body></html>