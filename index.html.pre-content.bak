89,"phaseId":10,"phase":"Capstone Project","phaseGoal":"Design, build, evaluate, deploy and present a complete Agentic AI application.","topic":"Capstone: deployment, README and technical documentation","objectives":["Explain the core ideas behind “Capstone: deployment, README and technical documentation” in your own words.","Implement a working example without copying a finished solution blindly.","Test, document and commit the result to GitHub."],"studyPlan":[{"label":"Study","minutes":45,"text":"Read the linked primary material and write 5–8 concise notes in your own words."},{"label":"Code","minutes":90,"text":"Deploy the application and finish README, setup guide, architecture, screenshots and known limitations."},{"label":"Challenge","minutes":30,"text":"Treat the capstone as production software: test, measure, document and justify every major design choice."},{"label":"Document","minutes":15,"text":"Commit code; update README with objective, approach, result, screenshot/output and one learning point."}],"resources":[{"title":"FastAPI in Containers - Docker","url":"https://fastapi.tiangolo.com/deployment/docker/"},{"title":"Docker: Get Started","url":"https://docs.docker.com/get-started/"},{"title":"LangSmith: Deployment","url":"https://docs.langchain.com/langsmith/deployment"},{"title":"GitHub Learn: Skills","url":"https://learn.github.com/skills"}],"video":"https://www.youtube.com/results?search_query=Capstone%3A%20deployment%2C%20README%20and%20technical%20documentation%20AI%20tutorial","knowledgeCheck":["What problem does “Capstone: deployment, README and technical documentation” solve, and when would you avoid using it?","What are the main failure modes or trade-offs in today's implementation?","How would you test whether today's solution is actually working correctly?"],"deliverable":"day-89-capstone-deployment-readme-and-technical-documentation","checks":["Study","Code","Challenge","GitHub"]},{"day":90,"phaseId":10,"phase":"Capstone Project","phaseGoal":"Design, build, evaluate, deploy and present a complete Agentic AI application.","topic":"Capstone: demo, GitHub release and technical presentation","objectives":["Explain the core ideas behind “Capstone: demo, GitHub release and technical presentation” in your own words.","Implement a working example without copying a finished solution blindly.","Test, document and commit the result to GitHub."],"studyPlan":[{"label":"Study","minutes":45,"text":"Read the linked primary material and write 5–8 concise notes in your own words."},{"label":"Code","minutes":90,"text":"Record/demo a 5–10 minute walkthrough, tag a GitHub release and prepare a concise technical presentation."},{"label":"Challenge","minutes":30,"text":"Treat the capstone as production software: test, measure, document and justify every major design choice."},{"label":"Document","minutes":15,"text":"Commit code; update README with objective, approach, result, screenshot/output and one learning point."}],"resources":[{"title":"GitHub Learn: Skills","url":"https://learn.github.com/skills"},{"title":"LangSmith: Observability","url":"https://docs.langchain.com/langsmith/observability"},{"title":"Anthropic Engineering Blog","url":"https://www.anthropic.com/engineering"},{"title":"Pydantic AI: Logfire Integration","url":"https://pydantic.dev/docs/ai/integrations/logfire/"}],"video":"https://www.youtube.com/results?search_query=Capstone%3A%20demo%2C%20GitHub%20release%20and%20technical%20presentation%20AI%20tutorial","knowledgeCheck":["What problem does “Capstone: demo, GitHub release and technical presentation” solve, and when would you avoid using it?","What are the main failure modes or trade-offs in today's implementation?","How would you test whether today's solution is actually working correctly?"],"deliverable":"day-90-capstone-demo-github-release-and-technical-presentation","checks":["Study","Code","Challenge","GitHub"]}],"phases":[{"id":1,"start":1,"end":10,"title":"Python & AI Engineering Foundations","goal":"Build the software-engineering base needed for LLM and agent systems."},{"id":2,"start":11,"end":20,"title":"Prompt & Context Engineering","goal":"Design reliable instructions, structured outputs and high-quality model context."},{"id":3,"start":21,"end":30,"title":"RAG Engineering","goal":"Build grounded retrieval systems from ingestion through evaluation."},{"id":4,"start":31,"end":40,"title":"AI Agents from Scratch","goal":"Understand and implement agent loops before relying on frameworks."},{"id":5,"start":41,"end":47,"title":"LangGraph Intensive","goal":"Build stateful, controllable and human-supervised agent workflows."},{"id":6,"start":48,"end":55,"title":"Memory, MCP & Agent Skills","goal":"Connect agents to memory, external tools and reusable capabilities."},{"id":7,"start":56,"end":65,"title":"Agent Framework Engineering","goal":"Compare and implement modern agent frameworks based on engineering needs."},{"id":8,"start":66,"end":73,"title":"Multi-Agent Systems","goal":"Coordinate specialized agents using routing, supervision and parallelism."},{"id":9,"start":74,"end":82,"title":"Production Agentic AI","goal":"Evaluate, secure, observe, optimize, package and deploy agent systems."},{"id":10,"start":83,"end":90,"title":"Capstone Project","goal":"Design, build, evaluate, deploy and present a complete Agentic AI application."}]};
/* ============================================================
   INSTRUCTOR CONFIG — leave url blank to disable class tracking
   entirely (the portal then stays 100% offline and anonymous).
   Paste the /exec URL and WRITE_KEY from your Apps Script deploy.
   ============================================================ */
const SYNC={
 url:"",   // e.g. "https://script.google.com/macros/s/AKfy.../exec"
 key:""    // the WRITE_KEY printed by setup()
};

const K="aiml-agentic-90-v2", TK="aiml-agentic-theme-v2", IK="aiml-agentic-identity-v1";
let state=(()=>{try{return JSON.parse(localStorage.getItem(K)||"{}")||{}}catch(e){return {}}})();

const $=id=>document.getElementById(id);
const VIEWS=["dashboard","roadmap","resources","projects"];
const esc=s=>String(s).replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
const md=s=>esc(s).replace(/\*\*(.+?)\*\*/g,"<strong>$1</strong>");
const host=u=>{try{return new URL(u).hostname.replace(/^www\./,"")}catch(e){return "link"}};

function ds(d){if(!state[d])state[d]={};return state[d]}
function peek(d){return state[d]||{}}
function done(d){const s=peek(d);return DATA.days[d-1].checks.every(c=>!!s[c])}
function count(){return DATA.days.filter(x=>done(x.day)).length}
function current(){const x=DATA.days.find(x=>!done(x.day));return x?x.day:90}
function persist(){try{localStorage.setItem(K,JSON.stringify(state))}catch(e){}scheduleSync()}

/* ---------- routing ---------- */
function go(hash){if(location.hash===hash)route();else location.hash=hash}
function setView(id){
 VIEWS.forEach(v=>$(v).classList.toggle("active",v===id));
 document.querySelectorAll('.nav button').forEach(b=>b.setAttribute("aria-selected",String(b.dataset.view===id)));
}
function route(){
 const h=(location.hash||"#dashboard").replace(/^#/,"");
 const m=/^day-(\d+)$/.exec(h);
 if(m){
  const n=Math.min(90,Math.max(1,parseInt(m[1],10)||1));
  setView("roadmap");renderDay(n);return;
 }
 const v=VIEWS.indexOf(h)>-1?h:"dashboard";
 setView(v);$("dayPanel").classList.add("hidden");
 try{window.scrollTo({top:0,behavior:"smooth"})}catch(e){}
}
window.addEventListener("hashchange",route);
document.querySelectorAll('.nav button').forEach(b=>b.onclick=()=>go("#"+b.dataset.view));

/* ---------- renderers ---------- */
function renderProgress(){
 const c=count(),p=Math.round(c/90*100);
 $("progTitle").textContent=c+" of 90 days completed";
 $("pct").textContent=p+"%";$("bar").style.width=p+"%";
 $("progWrap").setAttribute("aria-valuenow",String(p));
}
function renderPhases(){
 $("phaseGrid").innerHTML=DATA.phases.map(p=>{
  const arr=DATA.days.filter(d=>d.phaseId===p.id),c=arr.filter(d=>done(d.day)).length;
  return '<button class="phase" data-day="'+p.start+'"><span class="meta"><span>Phase '+p.id+'</span><span>'+c+'/'+arr.length+'</span></span><span class="ptitle">'+esc(p.title)+'</span><span class="pgoal muted">'+esc(p.goal)+'</span><span class="meta"><span>Days '+p.start+'–'+p.end+'</span><span>'+Math.round(c/arr.length*100)+'%</span></span></button>';
 }).join("");
}
function renderCalendar(){
 const cur=current();
 $("calendar").innerHTML=DATA.days.map(d=>{
  const isDone=done(d.day),isCur=d.day===cur&&!isDone;
  return '<button class="day '+(isDone?"done":"")+' '+(isCur?"current":"")+'" data-day="'+d.day+'" aria-label="Day '+d.day+': '+esc(d.topic)+(isDone?" — completed":isCur?" — current day":"")+'" title="Day '+d.day+': '+esc(d.topic)+'">'+d.day+'</button>';
 }).join("");
}
function renderRoadmap(q){
 q=(q||"").trim().toLowerCase();
 const groups=DATA.phases.map(p=>{
  const days=DATA.days.filter(d=>d.phaseId===p.id&&(!q||String(d.day).includes(q)||d.topic.toLowerCase().includes(q)||d.phase.toLowerCase().includes(q)));
  if(!days.length)return "";
  return '<div style="margin:22px 0"><span class="pill">Phase '+p.id+' • Days '+p.start+'–'+p.end+'</span><h3>'+esc(p.title)+'</h3>'+days.map(d=>'<button class="phase" style="margin:7px 0" data-day="'+d.day+'"><span class="meta"><span>Day '+d.day+'</span><span>'+(done(d.day)?"Completed ✓":"Open lesson →")+'</span></span><b>'+esc(d.topic)+'</b></button>').join("")+'</div>';
 }).join("");
 $("roadmapList").innerHTML=groups||"<p>No matching day found.</p>";
}
function renderDay(n){
 const d=DATA.days[n-1],s=peek(n),panel=$("dayPanel");
 panel.classList.remove("hidden");
 panel.innerHTML=
 '<div class="day-head"><div><span class="pill">Day '+d.day+' • Phase '+d.phaseId+'</span><h2>'+esc(d.topic)+'</h2><p class="muted">'+esc(d.phase)+'</p></div><button class="btn primary" id="completeDay" title="Toggle all four checklist items for this day">'+(done(n)?"Completed ✓":"Mark Day Complete")+'</button></div>'
 +'<p class="goal"><b>Phase goal:</b> '+esc(d.phaseGoal)+'</p>'
 +'<div class="grid2"><div><h3>Learning Objectives</h3><ul>'+d.objectives.map(x=>"<li>"+esc(x)+"</li>").join("")+'</ul></div><div><h3>Evidence to Produce</h3><p>GitHub folder/repository:</p><code>'+esc(d.deliverable)+'</code><p class="muted">Include objective, code, result/output, test/edge case, screenshot where useful, and learning summary.</p></div></div>'
 +"<h3>Today's 3-Hour Study Plan</h3><div class=\"plan\">"+d.studyPlan.map(x=>'<div class="slot"><b>'+esc(x.label)+'</b><small>'+x.minutes+' minutes</small><p>'+md(x.text)+'</p></div>').join("")+'</div>'
 +'<h3>Study Material &amp; Video <span class="muted" style="font-weight:400;font-size:.85rem">('+d.resources.length+' official sources)</span></h3><div class="resources">'
 +d.resources.map(r=>'<a class="resource" href="'+esc(r.url)+'" target="_blank" rel="noopener noreferrer"><b>📖 '+esc(r.title)+'</b><span>'+esc(host(r.url))+' ↗</span></a>').join("")
 +'<a class="resource" href="'+esc(d.video)+'" target="_blank" rel="noopener noreferrer"><b>🎥 Video Tutorials</b><span>YouTube search for today\'s exact topic ↗</span></a></div>'
 +'<h3>Knowledge Check</h3><ol>'+d.knowledgeCheck.map(q=>"<li>"+esc(q)+"</li>").join("")+'</ol>'
 +'<h3>Completion Checklist</h3><div class="checks">'+d.checks.map(c=>'<label><input type="checkbox" data-c="'+esc(c)+'" '+(s[c]?"checked":"")+'> '+esc(c)+'</label>').join("")+'</div>'
 +'<div class="button-row"><button class="btn outline" '+(n>1?'data-day="'+(n-1)+'"':"disabled")+'>← Previous</button><button class="btn primary" '+(n<90?'data-day="'+(n+1)+'"':"disabled")+'>Next Day →</button></div>';

 panel.querySelectorAll("[data-c]").forEach(x=>x.onchange=()=>{
  ds(n)[x.dataset.c]=x.checked;persist();
  $("completeDay").textContent=done(n)?"Completed ✓":"Mark Day Complete";
  refreshTrackers();
 });
 $("completeDay").onclick=()=>{
  const all=d.checks.every(c=>ds(n)[c]);
  d.checks.forEach(c=>ds(n)[c]=!all);
  persist();renderDay(n);refreshTrackers();
 };
 const raf=window.requestAnimationFrame||(f=>setTimeout(f,0));
 raf(()=>{try{panel.focus({preventScroll:true});if(panel.scrollIntoView)panel.scrollIntoView({behavior:"smooth",block:"start"})}catch(e){}});
}
function renderResources(){
 const byHost={};
 DATA.days.flatMap(d=>d.resources).forEach(r=>{
  const h=host(r.url);(byHost[h]=byHost[h]||{})[r.url]=r;
 });
 const hosts=Object.keys(byHost).sort();
 let total=0;hosts.forEach(h=>total+=Object.keys(byHost[h]).length);
 $("resourceCount").textContent=total+" curated links across "+hosts.length+" official sources.";
 $("resourceLibrary").innerHTML=hosts.map(h=>
  '<div style="margin:22px 0"><span class="pill">'+esc(h)+'</span><div class="resources" style="margin-top:10px">'
  +Object.values(byHost[h]).map(r=>'<a class="resource" href="'+esc(r.url)+'" target="_blank" rel="noopener noreferrer"><b>'+esc(r.title)+'</b><span>'+esc(r.url.replace(/^https?:\/\//,""))+' ↗</span></a>').join("")
  +'</div></div>').join("");
}
function renderProjects(){
 const nums=[10,20,30,40,47,55,60,62,65,73,82,90];
 $("projectGrid").innerHTML=nums.map(n=>{
  const d=DATA.days[n-1];
  return '<div class="project"><span class="pill">Day '+n+(done(n)?" • Completed ✓":"")+'</span><h3>'+esc(d.topic)+'</h3><p class="muted">'+md(d.studyPlan[1].text)+'</p><button class="btn soft" data-day="'+n+'">Open Project</button></div>';
 }).join("");
}
function refreshTrackers(){renderProgress();renderPhases();renderCalendar();renderRoadmap($("search").value);renderProjects()}
function renderAll(){refreshTrackers();renderResources()}

/* ---------- one delegated handler for every day link ---------- */
document.addEventListener("click",e=>{
 const t=e.target.closest("[data-day]");
 if(t&&!t.disabled)go("#day-"+t.dataset.day);
});

/* ---------- controls ---------- */
$("continue").onclick=()=>go("#day-"+current());
$("todayPlan").onclick=()=>go("#day-"+current());
$("search").oninput=e=>renderRoadmap(e.target.value);
$("export").onclick=()=>{
 const clean={};Object.keys(state).forEach(k=>{if(state[k]&&Object.keys(state[k]).length)clean[k]=state[k]});
 const blob=new Blob([JSON.stringify({app:"aiml-agentic-90",exportedAt:new Date().toISOString(),completed:count(),progress:clean},null,2)],{type:"application/json"});
 const a=document.createElement("a");a.href=URL.createObjectURL(blob);
 a.download="agentic-ai-90-progress-"+new Date().toISOString().slice(0,10)+".json";
 a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000);
};
$("import").onclick=()=>$("importFile").click();
$("importFile").onchange=e=>{
 const f=e.target.files&&e.target.files[0];if(!f)return;
 const r=new FileReader();
 r.onload=()=>{
  try{
   const o=JSON.parse(r.result);
   const p=(o&&typeof o==="object"&&o.progress&&typeof o.progress==="object")?o.progress:o;
   if(!p||typeof p!=="object"||Array.isArray(p))throw new Error("shape");
   state=p;persist();renderAll();route();
   alert("Progress imported: "+count()+" of 90 days marked complete.");
  }catch(err){alert("That file could not be read as a progress export. Use a JSON file created by the Export Progress button.")}
 };
 r.onerror=()=>alert("The file could not be read.");
 r.readAsText(f);e.target.value="";
};
$("reset").onclick=()=>{if(confirm("Reset all progress saved on this device?")){state={};try{localStorage.removeItem(K)}catch(e){}renderAll()}};

/* ---------- theme ---------- */
(function(){
 let saved=null;try{saved=localStorage.getItem(TK)}catch(e){}
 const dark=saved?saved==="dark":!!(window.matchMedia&&window.matchMedia("(prefers-color-scheme: dark)").matches);
 document.body.classList.toggle("dark",dark);
 $("theme").setAttribute("aria-pressed",String(dark));
})();
$("theme").onclick=()=>{
 const dark=document.body.classList.toggle("dark");
 $("theme").setAttribute("aria-pressed",String(dark));
 try{localStorage.setItem(TK,dark?"dark":"light")}catch(e){}
};

/* ---------- class tracking: sync progress to the instructor's sheet ---------- */
let identity=null,syncTimer=null,syncing=false,pending=false,lastSent="";

function loadIdentity(){
 try{const v=JSON.parse(localStorage.getItem(IK)||"null");if(v&&v.id&&v.name)identity=v}catch(e){identity=null}
}
/* 90 characters, one per day, each "0"–"4" = number of checklist items ticked */
function marksString(){
 let out="";
 for(let n=1;n<=90;n++){
  const st=peek(n);let c=0;
  DATA.days[n-1].checks.forEach(k=>{if(st[k])c++});
  out+=String(c);
 }
 return out;
}
function setSync(cls,text){
 const dot=$("syncDot");if(!dot)return;
 dot.className="syncdot"+(cls?" "+cls:"");
 $("syncText").textContent=text;
}
function trackingOn(){return !!(SYNC.url&&SYNC.key)}

function scheduleSync(){
 if(!trackingOn()||!identity)return;
 pending=true;
 clearTimeout(syncTimer);
 syncTimer=setTimeout(()=>syncNow(false),2500);   // debounce rapid ticking
}

async function syncNow(manual){
 if(!trackingOn()||!identity||syncing)return;
 if(!navigator.onLine){setSync("err","Offline — will sync when you reconnect.");return}
 const marks=marksString();
 // nothing changed since the last successful write — don't burn a quota unit
 if(!manual&&marks===lastSent){pending=false;return}
 syncing=true;setSync("busy",manual?"Syncing…":"Saving progress…");
 const payload={v:1,key:SYNC.key,student:identity,marks:marks,
                completed:count(),current:current(),clientTime:new Date().toISOString()};
 try{
  // text/plain keeps this a "simple" request, so the browser skips the CORS
  // preflight that Apps Script cannot answer.
  const res=await fetch(SYNC.url,{method:"POST",headers:{"Content-Type":"text/plain;charset=utf-8"},
                                  body:JSON.stringify(payload),redirect:"follow"});
  const out=await res.json();
  if(!out.ok)throw new Error(out.error||"rejected");
  pending=false;lastSent=marks;
  const t=new Date().toLocaleTimeString([],{hour:"2-digit",minute:"2-digit"});
  setSync("ok","Synced at "+t+" — "+out.completed+" of 90 days recorded.");
 }catch(err){
  setSync("err","Could not reach your instructor's sheet. Your progress is safe on this device and will retry.");
 }finally{syncing=false}
}

function paintIdentity(){
 if(!trackingOn())return;
 $("classCard").classList.remove("off");
 if(identity){
  $("stuId").value=identity.id;$("stuName").value=identity.name;$("stuClass").value=identity.class||"";
  $("classTitle").textContent="Linked as "+identity.name;
  $("classHelp").textContent="Progress is sent to your instructor automatically whenever you tick something. Only your name, ID, class and completed days are shared.";
  $("stuSave").textContent="Update details";
  $("stuSync").classList.remove("hidden");$("stuUnlink").classList.remove("hidden");
  if(!pending)setSync("ok","Linked. Waiting for your next update.");
 }else{
  setSync("","Not linked yet — enter your details to start sharing progress.");
 }
}

if(trackingOn()){
 loadIdentity();paintIdentity();
 $("stuSave").onclick=()=>{
  const id=$("stuId").value.trim(),name=$("stuName").value.trim(),cls=$("stuClass").value.trim();
  if(!id||!name){setSync("err","Roll number and full name are both required.");return}
  identity={id:id.toUpperCase(),name:name,class:cls.toUpperCase()};
  try{localStorage.setItem(IK,JSON.stringify(identity))}catch(e){}
  paintIdentity();syncNow(true);
 };
 $("stuSync").onclick=()=>syncNow(true);
 $("stuUnlink").onclick=()=>{
  if(!confirm("Stop sending progress from this device? Your day-by-day progress stays saved here, and your instructor keeps whatever was already recorded."))return;
  identity=null;try{localStorage.removeItem(IK)}catch(e){}
  $("stuId").value=$("stuName").value=$("stuClass").value="";
  $("classTitle").textContent="Link your progress to your class";
  $("stuSave").textContent="Save & link";
  $("stuSync").classList.add("hidden");$("stuUnlink").classList.add("hidden");
  setSync("","Unlinked. Nothing is being sent from this device.");
 };
 window.addEventListener("online",()=>{if(pending)syncNow(false)});
 // catch up on anything ticked while offline
 setTimeout(()=>{if(identity)syncNow(false)},1500);
}

/* ---------- PWA: install prompt + service worker ---------- */
(function(){
 // "Install App" button — only shown when the browser says it is installable.
 let deferred=null;
 const btn=$("install");
 window.addEventListener("beforeinstallprompt",e=>{
  e.preventDefault();deferred=e;btn.classList.remove("hidden");
 });
 btn.onclick=async()=>{
  if(!deferred)return;
  btn.disabled=true;
  deferred.prompt();
  try{await deferred.userChoice}catch(e){}
  deferred=null;btn.classList.add("hidden");btn.disabled=false;
 };
 window.addEventListener("appinstalled",()=>{deferred=null;btn.classList.add("hidden")});
 // Already running as an installed app? Nothing to install.
 if(window.matchMedia&&window.matchMedia("(display-mode: standalone)").matches)btn.classList.add("hidden");
})();

(function(){
 if(!("serviceWorker" in navigator))return;
 // file:// has no service worker support; skip quietly so local testing still works.
 if(location.protocol==="file:")return;

 const banner=$("swBanner"),reload=$("swReload"),dismiss=$("swDismiss");
 let waiting=null,reloading=false;

 function offerUpdate(worker){waiting=worker;banner.classList.add("show")}
 dismiss.onclick=()=>banner.classList.remove("show");
 reload.onclick=()=>{
  if(!waiting)return location.reload();
  reload.disabled=true;reload.textContent="Updating…";
  waiting.postMessage({type:"SKIP_WAITING"});
 };
 navigator.serviceWorker.addEventListener("controllerchange",()=>{
  if(reloading)return;reloading=true;location.reload();
 });

 window.addEventListener("load",()=>{
  navigator.serviceWorker.register("sw.js",{scope:"./"}).then(reg=>{
   if(reg.waiting&&navigator.serviceWorker.controller)offerUpdate(reg.waiting);
   reg.addEventListener("updatefound",()=>{
    const nw=reg.installing;if(!nw)return;
    nw.addEventListener("statechange",()=>{
     // controller present means this is an update, not the very first install
     if(nw.state==="installed"&&navigator.serviceWorker.controller)offerUpdate(nw);
    });
   });
   // Check for a new version when the app is reopened or refocused.
   const check=()=>{if(document.visibilityState==="visible")reg.update().catch(()=>{})};
   document.addEventListener("visibilitychange",check);
   setTimeout(check,1000*60*30);
  }).catch(()=>{/* offline or blocked: the app still works, just without caching */});
 });
})();

renderAll();route();
</script>
</body></html>
