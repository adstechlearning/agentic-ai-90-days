<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>AIML – 90 Days to Agentic AI Engineer</title>
<meta name="description" content="A free, self-paced 90-day study plan that takes you from Python fundamentals to deployed, evaluated agentic AI systems. 3 hours a day, 270 hours, 10 phases, 12 portfolio projects, and 130+ links to official documentation.">
<meta name="color-scheme" content="light dark">
<meta name="theme-color" content="#f3f6fb" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#090e1a" media="(prefers-color-scheme: dark)">
<meta property="og:type" content="website">
<meta property="og:title" content="90 Days to Agentic AI Engineer">
<meta property="og:description" content="Self-paced 90-day roadmap: Python → prompting → RAG → agents → LangGraph → MCP → multi-agent → production. 3 hours a day, tracked in your browser.">
<meta property="og:site_name" content="AIML Student Learning Portal">
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="90 Days to Agentic AI Engineer">
<meta name="twitter:description" content="Self-paced 90-day roadmap from Python fundamentals to deployed agentic AI systems.">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%234f46e5'/%3E%3Ctext x='16' y='22' font-family='system-ui,sans-serif' font-size='16' font-weight='800' fill='white' text-anchor='middle'%3E90%3C/text%3E%3C/svg%3E">
<link rel="manifest" href="manifest.webmanifest">
<link rel="apple-touch-icon" href="icons/apple-touch-icon.png">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="90 Days AI">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="application-name" content="90 Days AI">
<style>
:root{--bg:#f3f6fb;--card:#fff;--text:#101828;--muted:#667085;--line:#e4e7ec;--accent:#4f46e5;--soft:#eef2ff;--good:#067647;--warn:#b54708;--shadow:0 12px 35px rgba(16,24,40,.08)}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;background:var(--bg);color:var(--text);line-height:1.55}
body.dark{--bg:#090e1a;--card:#111827;--text:#f8fafc;--muted:#a6b0c3;--line:#283548;--soft:#1c2540;--shadow:none}
button,input{font:inherit}button{cursor:pointer;border:0}a{color:inherit}
:focus-visible{outline:3px solid var(--accent);outline-offset:2px;border-radius:8px}
button[disabled]{opacity:.4;cursor:not-allowed}
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
.header{max-width:1200px;margin:auto;padding:26px 20px 14px;display:flex;justify-content:space-between;gap:20px;align-items:flex-start}
.brand small,.eyebrow{font-weight:850;letter-spacing:.12em;color:var(--accent);font-size:.72rem}h1{font-size:clamp(2rem,5vw,4.2rem);line-height:1;margin:.35rem 0 .65rem;letter-spacing:-.045em}.brand p{margin:0;color:var(--muted)}
.shell{max-width:1200px;margin:auto;padding:0 20px 50px}
.nav{position:sticky;top:0;z-index:20;background:color-mix(in srgb,var(--bg) 88%,transparent);backdrop-filter:blur(12px);border-bottom:1px solid var(--line);margin-bottom:18px}
.nav-inner{max-width:1200px;margin:auto;padding:10px 20px;display:flex;gap:8px;overflow:auto}
.nav button{padding:9px 13px;border-radius:10px;background:transparent;color:var(--muted);font-weight:750;white-space:nowrap}.nav button[aria-selected="true"]{background:var(--card);color:var(--text);box-shadow:var(--shadow)}
.card{background:var(--card);border:1px solid var(--line);border-radius:20px;padding:21px;box-shadow:var(--shadow);margin-bottom:16px}
.hero{display:grid;grid-template-columns:1.45fr .75fr;gap:16px}.hero h2{font-size:1.6rem;margin:.2rem 0}.muted{color:var(--muted)}.pill{display:inline-block;padding:5px 9px;border-radius:999px;background:var(--soft);color:var(--accent);font-size:.76rem;font-weight:850}
.progress-line{height:12px;background:var(--soft);border-radius:999px;overflow:hidden;margin:15px 0}#bar{height:100%;background:var(--accent);width:0;transition:width .3s ease}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:9px}.stat{background:var(--soft);padding:11px;border-radius:14px;text-align:center}.stat b{font-size:1.2rem;display:block}.stat span{font-size:.75rem;color:var(--muted)}
.btn{padding:11px 14px;border-radius:12px;font-weight:800}.primary{background:var(--accent);color:#fff}.soft{background:var(--soft);color:var(--text)}.outline{background:transparent;border:1px solid var(--line);color:var(--text)}.button-row{display:flex;gap:9px;flex-wrap:wrap;margin-top:15px}
.section-head{display:flex;justify-content:space-between;align-items:end;gap:15px;margin-bottom:15px}.section-head h2{margin:.15rem 0}input[type=search]{width:min(360px,100%);padding:11px 13px;border-radius:12px;border:1px solid var(--line);background:var(--bg);color:var(--text)}
.phase-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:11px}.phase{border:1px solid var(--line);border-radius:16px;padding:15px;cursor:pointer;text-align:left;width:100%;background:transparent;color:inherit;display:block}.phase:hover{border-color:var(--accent)}.phase h3,.phase .ptitle{font-size:1rem;margin:.3rem 0;font-weight:800;display:block}.phase .pgoal{display:block;font-size:.9rem;margin-bottom:.4rem}.meta{font-size:.8rem;color:var(--muted);display:flex;justify-content:space-between;gap:10px}
.calendar{display:grid;grid-template-columns:repeat(15,1fr);gap:7px}.day{aspect-ratio:1;border-radius:10px;background:var(--bg);border:1px solid var(--line);color:var(--text);font-weight:850}.day.done{background:var(--accent);color:white;border-color:var(--accent)}.day.current{outline:3px solid var(--soft);border-color:var(--accent)}
.hidden{display:none!important}.view{display:none}.view.active{display:block}
.day-head{display:flex;justify-content:space-between;gap:15px;align-items:flex-start}.day-head h2{margin:.35rem 0}.goal{padding:12px 14px;background:var(--soft);border-radius:13px}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:14px}.plan{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.slot{border:1px solid var(--line);border-radius:14px;padding:13px}.slot b,.slot small{display:block}.slot small{color:var(--muted)}
.resources{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.resource{display:block;text-decoration:none;border:1px solid var(--line);border-radius:13px;padding:13px}.resource:hover{border-color:var(--accent)}.resource b{display:block}.resource span{font-size:.8rem;color:var(--muted)}
.checks{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.checks label{border:1px solid var(--line);border-radius:12px;padding:11px;display:flex;align-items:center;gap:7px;cursor:pointer}
code{background:var(--soft);padding:3px 6px;border-radius:7px;word-break:break-all}ol,ul{padding-left:1.25rem}
.project-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:11px}.project{border:1px solid var(--line);border-radius:15px;padding:15px}.project h3{margin:.25rem 0}
footer{max-width:1200px;margin:auto;padding:0 20px 35px;color:var(--muted)}
#dayPanel:focus{outline:none}
#classCard.off{display:none}
.idrow{display:flex;gap:9px;flex-wrap:wrap;margin-top:12px}.idrow input{flex:1 1 160px;min-width:0;padding:11px 13px;border-radius:12px;border:1px solid var(--line);background:var(--bg);color:var(--text)}
.syncdot{display:inline-block;width:9px;height:9px;border-radius:50%;background:var(--muted);margin-right:7px;vertical-align:middle}
.syncdot.ok{background:var(--good)}.syncdot.err{background:#d92d20}.syncdot.busy{background:var(--warn)}
#syncMsg{font-size:.85rem;color:var(--muted);margin:10px 0 0}
#swBanner{position:fixed;left:50%;transform:translateX(-50%);bottom:18px;z-index:60;display:none;align-items:center;gap:12px;background:var(--card);color:var(--text);border:1px solid var(--line);border-radius:14px;padding:12px 14px;box-shadow:0 12px 35px rgba(16,24,40,.22);max-width:min(560px,calc(100vw - 32px))}
#swBanner.show{display:flex}#swBanner p{margin:0;font-size:.9rem}
#swBanner .btn{padding:8px 12px;border-radius:10px;font-size:.85rem}
@media(display-mode:standalone){.installOnly{display:none!important}}
noscript .card{margin:20px}
@media(max-width:850px){.hero,.phase-grid,.grid2,.project-grid{grid-template-columns:1fr}.calendar{grid-template-columns:repeat(10,1fr)}.plan,.checks{grid-template-columns:repeat(2,1fr)}.section-head{align-items:flex-start;flex-direction:column}}
@media(max-width:520px){.card{padding:16px;border-radius:16px}.stats{grid-template-columns:repeat(2,1fr)}.calendar{grid-template-columns:repeat(6,1fr)}.plan,.checks,.resources{grid-template-columns:1fr}.header{padding-top:20px}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}#bar{transition:none}}
@media print{.nav,#theme,.button-row,footer,.calendar,.stats{display:none!important}.view{display:block!important}.card{box-shadow:none;border:1px solid #ccc;break-inside:avoid}body{background:#fff;color:#000}a[href^="http"]::after{content:" (" attr(href) ")";font-size:.75em;color:#555}}
</style>
</head>
<body>
<header class="header"><div class="brand"><small>AIML STUDENT LEARNING PORTAL</small><h1>90 Days to Agentic AI Engineer</h1><p>3 Hours/Day • 270 Hours • Learn → Code → Build → Evaluate → Deploy</p></div><button id="theme" class="btn outline" aria-label="Toggle dark mode" aria-pressed="false" title="Toggle dark mode">◐</button></header>

<noscript><div class="card"><h2>JavaScript is required</h2><p>This study portal renders the 90-day plan, your progress tracker and the resource library in the browser. Please enable JavaScript to use it. All content is static and free — nothing is sent to a server.</p></div></noscript>

<nav class="nav" aria-label="Sections"><div class="nav-inner" role="tablist">
<button data-view="dashboard" role="tab" aria-selected="true" aria-controls="dashboard">Dashboard</button>
<button data-view="roadmap" role="tab" aria-selected="false" aria-controls="roadmap">90-Day Roadmap</button>
<button data-view="resources" role="tab" aria-selected="false" aria-controls="resources">Resources</button>
<button data-view="projects" role="tab" aria-selected="false" aria-controls="projects">Projects</button>
</div></nav>

<main class="shell">
<section id="dashboard" class="view active" role="tabpanel" tabindex="-1">
<div class="hero">
<article class="card"><span class="pill">YOUR LEARNING JOURNEY</span><h2 id="progTitle">0 of 90 days completed</h2><div class="progress-line" id="progWrap" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-label="Overall course progress"><div id="bar"></div></div>
<div class="stats"><div class="stat"><b id="pct">0%</b><span>Progress</span></div><div class="stat"><b>270</b><span>Total Hours</span></div><div class="stat"><b>10</b><span>Phases</span></div><div class="stat"><b>12</b><span>Portfolio Builds</span></div></div>
<div class="button-row"><button id="continue" class="btn primary">Continue Learning</button><button id="todayPlan" class="btn soft">Open Current Day</button></div></article>
<article class="card"><span class="eyebrow">DAILY RULE</span><h2>3 hours. Every day.</h2><p><b>45 min</b> study → <b>90 min</b> coding → <b>30 min</b> challenge → <b>15 min</b> GitHub documentation.</p><p class="muted">Progress is saved in this browser only. Export it to move between devices — then use Import to restore it.</p><div class="button-row"><button id="install" class="btn soft installOnly hidden">⤓ Install App</button><button id="export" class="btn soft">Export Progress</button><button id="import" class="btn soft">Import Progress</button><button id="reset" class="btn outline">Reset Progress</button></div>
<input type="file" id="importFile" accept="application/json,.json" class="sr-only" aria-hidden="true" tabindex="-1"></article>
</div>
<div class="card off" id="classCard"><span class="eyebrow">CLASS TRACKING</span><h2 id="classTitle">Link your progress to your class</h2><p class="muted" id="classHelp">Enter your details once. Your day-by-day progress is then sent to your instructor's sheet each time it changes. Only your name, ID, class and which days you have completed are sent — nothing else.</p><div class="idrow"><label class="sr-only" for="stuId">Roll number or student ID</label><input id="stuId" placeholder="Roll number / student ID" autocomplete="off" spellcheck="false"><label class="sr-only" for="stuName">Full name</label><input id="stuName" placeholder="Full name" autocomplete="name"><label class="sr-only" for="stuClass">Class or section</label><input id="stuClass" placeholder="Class / section (e.g. CSE-A)" autocomplete="off"></div><p id="syncMsg"><span class="syncdot" id="syncDot"></span><span id="syncText">Not linked yet.</span></p><div class="button-row"><button id="stuSave" class="btn primary">Save &amp; link</button><button id="stuSync" class="btn soft hidden">Sync now</button><button id="stuUnlink" class="btn outline hidden">Unlink this device</button></div></div>
<div class="card"><div class="section-head"><div><span class="eyebrow">PHASES</span><h2>Program Architecture</h2></div></div><div id="phaseGrid" class="phase-grid"></div></div>
<div class="card"><div class="section-head"><div><span class="eyebrow">CALENDAR</span><h2>90-Day Progress</h2></div></div><div id="calendar" class="calendar"></div></div>
</section>

<section id="roadmap" class="view" role="tabpanel" tabindex="-1">
<div class="card"><div class="section-head"><div><span class="eyebrow">FULL PROGRAM</span><h2>Day 1 → Day 90</h2></div><div><label for="search" class="sr-only">Search the roadmap by topic, phase or day number</label><input id="search" type="search" placeholder="Search topic, phase or day…"></div></div><div id="roadmapList"></div></div>
<div id="dayPanel" class="card hidden" tabindex="-1" aria-live="polite"></div>
</section>

<section id="resources" class="view" role="tabpanel" tabindex="-1">
<div class="card"><span class="eyebrow">STUDY LIBRARY</span><h2>Primary Learning Resources</h2><p class="muted">Every link below points at free, official documentation and courses, grouped by source. Each daily page also includes a topic-specific YouTube search link for supplementary video learning.</p><p class="muted" id="resourceCount"></p><div id="resourceLibrary"></div></div>
</section>

<section id="projects" class="view" role="tabpanel" tabindex="-1">
<div class="card"><span class="eyebrow">PORTFOLIO</span><h2>Projects &amp; Evidence of Learning</h2><p>Students should finish the program with working code, documentation and measurable outputs—not only course-completion screenshots.</p><div id="projectGrid" class="project-grid"></div></div>
<div class="card"><h2>Final Capstone Standard</h2><p><b>Recommended:</b> Autonomous AI Research Engineer.</p><p>Minimum architecture: user problem → planner → retrieval/RAG → tools → agent workflow → memory/MCP → verifier → human approval → final report → evaluation → deployment.</p></div>
</section>
</main>
<div id="swBanner" role="status" aria-live="polite"><p><b>Update available.</b> A newer version of the study plan has been published.</p><button id="swReload" class="btn primary">Reload</button><button id="swDismiss" class="btn outline" aria-label="Dismiss update notice">Later</button></div>
<footer>AIML – 90 Days to Agentic AI Engineer • Single-file GitHub Pages edition • Progress stored locally in your browser</footer>

<script>
const DATA={"title":"AIML – 90 Days to Agentic AI Engineer","subtitle":"Learn • Code • Build • Evaluate • Deploy","days":[{"day":1,"phaseId":1,"phase":"Python & AI Engineering Foundations","phaseGoal":"Build the software-engineering base needed for LLM and agent systems.","topic":"Python refresh: functions, collections and comprehensions","objectives":["Explain the core ideas behind “Python refresh: functions, collections and comprehensions” in your own words.","Implement a working example without copying a finished solution blindly.","Test, document and commit the result to GitHub."],"studyPlan":[{"label":"Study","minutes":45,"text":"Read the linked primary material and write 5–8 concise notes in your own words."},{"label":"Code","minutes":90,"text":"Create a focused notebook or Python project demonstrating **Python refresh: functions, collections and comprehensions**. Include at least one test case and one failure/edge case."},{"label":"Challenge","minutes":30,"text":"Refactor for readability, type hints and configuration; avoid hard-coded secrets."},{"label":"Document","minutes":15,"text":"Commit code; update README with objective, approach, result, screenshot/output and one learning point."}],"resources":[{"title":"Python Official Tutorial","url":"https://docs.python.org/3/tutorial/index.html"},{"title":"Python: Control Flow & Functions","url":"https://docs.python.org/3/tutorial/controlflow.html"},{"title":"Python: Data Structures","url":"https://docs.python.org/3/tutorial/datastructures.html"}],"video":"https://www.youtube.com/results?search_query=Python%20refresh%3A%20functions%2C%20collections%20and%20comprehensions%20AI%20tutorial","knowledgeCheck":["What problem does “Python refresh: functions, collections and comprehensions” solve, and when would you avoid using it?","What are the main failure modes or trade-offs in today's implementation?","How would you test whether today's solution is actually working correctly?"],"deliverable":"day-01-python-refresh-functions-collections-and-comprehensions","checks":["Study","Code","Challenge","GitHub"]},{"day":2,"phaseId":1,"phase":"Python & AI Engineering Foundations","phaseGoal":"Build the software-engineering base needed for LLM and agent systems.","topic":"OOP, dataclasses, typing and Pydantic","objectives":["Explain the core ideas behind “OOP, dataclasses, typing and Pydantic” in your own words.","Implement a working example without copying a finished solution blindly.","Test, document and commit the result to GitHub."],"studyPlan":[{"label":"Study","minutes":45,"text":"Read the linked primary material and write 5–8 concise notes in your own words."},{"label":"Code","minutes":90,"text":"Create a focused notebook or Python project demonstrating **OOP, dataclasses, typing and Pydantic**. Include at least one test case and one failure/edge case."},{"label":"Challenge","minutes":30,"text":"Refactor for readability, type hints and configuration; avoid hard-coded secrets."},{"label":"Document","minutes":15,"text":"Commit code; update README with objective, approach, result, screenshot/output and one learning point."}],"resources":[{"title":"Python: Classes & OOP","url":"https://docs.python.org/3/tutorial/classes.html"},{"title":"Pydantic Validation: Get Started","url":"https://pydantic.dev/docs/validation/latest/get-started"},{"title":"Pydantic: Models","url":"https://pydantic.dev/docs/validation/latest/concepts/models/"},{"title":"FastAPI: Python Types Intro","url":"https://fastapi.tiangolo.com/python-types/"}],"video":"https://www.youtube.com/results?search_query=OOP%2C%20dataclasses%2C%20typing%20and%20Pydantic%20AI%20tutorial","knowledgeCheck":["What problem does “OOP, dataclasses, typing and Pydantic” solve, and when would you avoid using it?","What are the main failure modes or trade-offs in today's implementation?","How would you test whether today's solution is actually working correctly?"],"deliverable":"day-02-oop-dataclasses-typing-and-pydantic","checks":["Study","Code","Challenge","GitHub"]},{"day":3,"phaseId":1,"phase":"Python & AI Engineering Foundations","phaseGoal":"Build the software-engineering base needed for LLM and agent systems.","topic":"Files, JSON, CSV, environment variables and configuration","objectives":["Explain the core ideas behind “Files, JSON, CSV, environment variables and configuration” in your own words.","Implement a working example without copying a finished solution blindly.","Test, document and commit the result to GitHub."],"studyPlan":[{"label":"Study","minutes":45,"text":"Read the linked primary material and write 5–8 concise notes in your own words."},{"label":"Code","minutes":90,"text":"Create a focused notebook or Python project demonstrating **Files, JSON, CSV, environment variables and configuration**. Include at least one test case and one failure/edge case."},{"label":"Challenge","minutes":30,"text":"Refactor for readability, type hints and configuration; avoid hard-coded secrets."},{"label":"Document","minutes":15,"text":"Commit code; update README with objective, approach, result, screenshot/output and one learning point."}],"resources":[{"title":"Python: Input, Output & JSON","url":"https://docs.python.org/3/tutorial/inputoutput.html"},{"title":"Python: Modules & Packages","url":"https://docs.python.org/3/tutorial/modules.html"},{"title":"Pydantic: Settings Management","url":"https://pydantic.dev/docs/validation/latest/concepts/pydantic_settings/"}],"video":"https://www.youtube.com/results?search_query=Files%2C%20JSON%2C%20CSV%2C%20environment%20variables%20and%20configuration%20AI%20tutorial","knowledgeCheck":["What problem does “Files, JSON, CSV, environment variables and configuration” solve, and when would you avoid using it?","What are the main failure modes or trade-offs in today's implementation?","How would you test whether today's solution is actually working correctly?"],"deliverable":"day-03-files-json-csv-environment-variables-and-configuration","checks":["Study","Code","Chall